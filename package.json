{
  "name": "quickbrain",
  "version": "1.0.0",
  "description": "Personal knowledge management - quickly search and organize scattered information",
  "main": "client/src/main/electron-entry.js",
  "scripts": {
    "start": "electron .",
    "postinstall:register": "electron . --register-native-host",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "npx --yes @electron/rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test:all": "npm run rebuild:node && npm test",
    "start:fresh": "npm run rebuild:electron && electron .",
    "build:mac": "electron-builder --mac --arm64",
    "build:mac:universal": "electron-builder --mac --arm64 --x64",
    "build:mac:intel": "electron-builder --mac --x64",
    "build:editor": "node client/scripts/build-editor.js",
    "prebuild:win": "npm run build:icons && npm run build:editor",
    "prebuild": "npm run build:icons && npm run build:editor",
    "build:icons": "node client/scripts/build-icons.js",
    "prebuild:editor": "npm run build:icons"
  },
  "keywords": [
    "knowledge",
    "notes",
    "search",
    "productivity"
  ],
  "author": "QuickBrain <hi@bjhzsk.cn>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "sharp-ico": "^0.1.5",
    "vitest": "^1.6.1",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@node-rs/jieba": "^0.4.0",
    "@quickbrain/shared": "file:./shared",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "openai": "^4.104.0",
    "pinyin-pro": "^3.29.3",
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.quickbrain.app",
    "productName": "QuickBrain",
    "directories": {
      "output": "dist"
    },
    "files": [
      "client/**/*",
      "shared/**/*",
      "assets/**/*",
      "extension/**/*",
      "resources/**/*",
      "package.json",
      "node_modules/@quickbrain/shared/**/*",
      "!build{,/**/*}",
      "!dist{,/**/*}",
      "!**/{.editorconfig,.eslintrc*,.prettierrc*,.gitattributes,.gitignore,.npmignore,.travis.yml,*.md,*.markdown,*.map,test,tests,test/**,tests/**,__tests__,__tests__/**,coverage,coverage/**,docs,docs/**,example,examples,example/**,examples/**}",
      "!**/{.DS_Store,Thumbs.db,desktop.ini}",
      "!**/*.{iml,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,suo,xproj,cc,d.ts,mk,a,o,forge-meta,pdb}",
      "!**/._*",
      "!**/electron-builder.{yaml,yml,json,json5,toml,ts}",
      "!**/{.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,.DS_Store,thumbs.db,.gitignore,.gitkeep,.gitattributes,.npmignore,.idea,.vs,.flowconfig,.jshintrc,.eslintrc,.circleci,.yarn-integrity,.yarn-metadata.json,yarn-error.log,yarn.lock,package-lock.json,npm-debug.log,appveyor.yml,.travis.yml,circle.yml,.nyc_output,.husky,.github,electron-builder.env}"
    ],
    "win": {
      "target": "nsis",
      "icon": "client/src/assets/icon.ico",
      "signAndEditExecutable": false,
      "publish": {
        "provider": "generic",
        "url": "https://note.bjhzsk.cn/download/windows"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "browser-extension"
      },
      {
        "from": "resources/native-host.json",
        "to": "native-host.json"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/@node-rs/jieba/**/*",
      "**/node_modules/bindings/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "client/src/assets/icon@6x.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "publish": {
        "provider": "generic",
        "url": "https://note.bjhzsk.cn/download/mac"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "client/src/assets/icon@6x.png",
      "synopsis": "Personal knowledge management - quickly search and organize scattered information",
      "desktop": {
        "Name": "QuickBrain"
      },
      "publish": {
        "provider": "generic",
        "url": "https://note.bjhzsk.cn/download/linux"
      }
    },
    "afterPack": "scripts/after-pack-icon.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://note.bjhzsk.cn/download/windows"
      },
      {
        "provider": "generic",
        "url": "https://note.bjhzsk.cn/download/mac"
      },
      {
        "provider": "generic",
        "url": "https://note.bjhzsk.cn/download/linux"
      }
    ]
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ]
}
