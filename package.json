{
  "name": "quickbrain",
  "version": "1.0.0",
  "description": "Personal knowledge management - quickly search and organize scattered information",
  "main": "client/src/main/electron-entry.js",
  "scripts": {
    "start": "electron .",
    "postinstall:register": "electron . --register-native-host",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "npx --yes @electron/rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test:all": "npm run rebuild:node && npm test",
    "start:fresh": "npm run rebuild:electron && electron ."
  },
  "keywords": [
    "knowledge",
    "notes",
    "search",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.quickbrain.app",
    "productName": "QuickBrain",
    "directories": {
      "output": "dist"
    },
    "files": [
      "client/**/*",
      "shared/**/*",
      "server/**/*",
      "assets/**/*",
      "extension/**/*",
      "resources/**/*",
      "package.json",
      "!node_modules/**/{.bin,*.md,*.markdown,*.map,test,test/**/*,tests,tests/**/*,__tests__,__tests__/**/*}",
      "!client/**/test/**",
      "!client/**/tests/**",
      "!shared/**/test/**",
      "!shared/**/tests/**",
      "!server/**/test/**",
      "!server/**/tests/**",
      "!**/.DS_Store",
      "!**/Thumbs.db"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "client/src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "browser-extension"
      },
      {
        "from": "resources/native-host.json",
        "to": "native-host.json"
      }
    ]
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ]
}