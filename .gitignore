# Local CDP / migration scripts: ad-hoc debugging tools that should never
# be checked in. Living next to the repo root so they share node_modules
# and the package version of `ws`, but they are throwaway.
/cdp-*.js
/fix-*.py
/query-server.js
/tmp.js

# Ad-hoc debugging / throwaway scripts not meant for the repo
/tmp-*.js
