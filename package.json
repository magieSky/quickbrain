{
  "name": "quickbrain",
  "version": "1.0.0",
  "description": "个人知识管理工具 - 快速检索和整理散落的信息",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": ["knowledge", "notes", "search", "productivity"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "sql.js": "^1.10.3",
    "openai": "^4.20.0"
  },
  "build": {
    "appId": "com.quickbrain.app",
    "productName": "QuickBrain",
    "directories": {"output": "dist"},
    "files": ["**/*", "!**/*.ts", "!**/node_modules/*"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
