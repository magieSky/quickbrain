{
  "name": "quickbrain",
  "version": "1.0.0",
  "description": "个人知识管理工具 - 快速检索和整理散落的信息",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall:register": "electron . --register-native-host",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron": "npx --yes @electron/rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test:all": "npm run rebuild:node && npm test",
    "start:fresh": "npm run rebuild:electron && electron ."
  },
  "keywords": [
    "knowledge",
    "notes",
    "search",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@node-rs/jieba": "^0.4.0",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^11.10.0",
    "openai": "^4.20.0",
    "pinyin-pro": "^3.29.3",
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.quickbrain.app",
    "productName": "QuickBrain",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!**/node_modules/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
