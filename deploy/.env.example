# QuickBrain server deployment env
# Generate MASTER_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate OWNER_TOKEN: any long random string (use a password manager)
MASTER_KEY=REPLACE_WITH_64_HEX_CHARS
OWNER_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING

# Optional
QB_MODE=byos
QB_PORT=7421
